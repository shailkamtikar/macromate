ENVIRONMENT=development

# Supabase (Postgres + Auth + Realtime) — https://app.supabase.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Same value as frontend/.env.local's NEXT_PUBLIC_SUPABASE_ANON_KEY — not
# secret, but only used by RLS-focused tests, never in runtime request paths.
SUPABASE_ANON_KEY=
# Required only to apply backend/supabase/migrations/*.sql via the Supabase
# CLI or Management API (Dashboard -> Account -> Access Tokens).
SUPABASE_ACCESS_TOKEN=

# Gemini AI layer (PRD 4.4)
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Firebase Cloud Messaging (push notifications, PRD 4.5)
FCM_SERVER_KEY=

# JSON array of allowed frontend origins
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
